# No frontend env vars yet — /api is proxied to the backend by vite.config.js
# in dev, and served from the same origin in production. Add VITE_-prefixed
# vars here if/when the frontend needs build-time config.

# "Sign in with Google" — the OAuth 2.0 Client ID from Google Cloud Console
# (not a secret; it's meant to be embedded in client-side JS). Must match
# GOOGLE_CLIENT_ID in backend/.env.
VITE_GOOGLE_CLIENT_ID=
