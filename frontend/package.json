{
  "name": "datapit-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/content-index.mjs && vite build && vite build --ssr src/prerender/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:prod": "PRERENDER_API_URL=http://127.0.0.1:4000 npm run build",
    "content": "node scripts/content-index.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "og-images": "node scripts/og-images.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@reduxjs/toolkit": "^2.2.7",
    "cmdk": "^1.1.1",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.18.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.5",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
