# Dummy values for automated tests. env.js only validates shape/presence here;
# the health/liveness tests never make real connections. Safe to commit —
# no real credentials, matches CI's ephemeral service containers.
NODE_ENV=test
PORT=4001

DATABASE_URL=postgresql://signalbase:signalbase@localhost:5432/datapit_test
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

JWT_ACCESS_SECRET=test-access-secret-not-for-production-use-0000000000
JWT_REFRESH_SECRET=test-refresh-secret-not-for-production-use-0000000000
ADMIN_JWT_SECRET=test-admin-secret-not-for-production-use-00000000000000
ESP_WEBHOOK_SECRET=test-esp-webhook-secret-not-for-production-0000000
STRIPE_WEBHOOK_SECRET=whsec_test_not_for_production_00000000000000000000
SETTINGS_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

CORS_ORIGIN=http://localhost:5173
