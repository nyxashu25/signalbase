# Dummy values for automated tests. env.js only validates shape/presence here;
# the health/liveness tests never make real connections. Safe to commit —
# no real credentials, matches CI's ephemeral service containers.
NODE_ENV=test
PORT=4001

DATABASE_URL=postgresql://signalbase:signalbase@localhost:5432/signalbase_test
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

JWT_ACCESS_SECRET=test-access-secret-not-for-production-use-0000000000
JWT_REFRESH_SECRET=test-refresh-secret-not-for-production-use-0000000000

CORS_ORIGIN=http://localhost:5173
