# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://signalbase:signalbase@localhost:5432/signalbase
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-string

# Optional — defaults shown (15 minutes / 30 days).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Optional. Unset = sends are simulated (logged, not delivered) — see espService.js.
ESP_API_KEY=
# Required even in simulated-send mode — verifies inbound ESP webhook signatures.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ESP_WEBHOOK_SECRET=replace-with-a-random-32-char-hex-string

# Optional — pattern-guessed emails are never verified until a provider key is set.
EMAIL_VERIFIER_API_KEY=

# Optional. Unset = checkout session creation is simulated — see stripeService.js.
STRIPE_SECRET_KEY=
# Required even without a secret key — verifies inbound Stripe webhook signatures.
# From the Stripe dashboard (or `stripe listen` in dev): starts with whsec_
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_value

CORS_ORIGIN=http://localhost:5173
