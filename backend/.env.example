# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://signalbase:signalbase@localhost:5432/datapit
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
# Optional: prefix for ES index names (tests set "test-" via .env.test; leave
# empty for dev/prod).
# ES_INDEX_PREFIX=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-string
# Super admin auth — must differ from both secrets above.
ADMIN_JWT_SECRET=replace-with-a-third-random-64-char-hex-string

# Optional — defaults shown (15 minutes / 30 days).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Optional. Unset = sends are simulated (logged, not delivered) — see espService.js.
# SendGrid API key (Settings -> API Keys, needs "Mail Send" permission).
ESP_API_KEY=
# Required once ESP_API_KEY is set — must be a verified sender/domain in SendGrid.
ESP_FROM_EMAIL=
# Required even in simulated-send mode — verifies inbound ESP webhook signatures.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ESP_WEBHOOK_SECRET=replace-with-a-random-32-char-hex-string

# Optional — pattern-guessed emails are never verified until a provider key is set.
# Hunter.io API key (https://hunter.io/api-keys).
EMAIL_VERIFIER_API_KEY=

# Stripe is configured through the super admin UI (/control/settings), not
# env vars — the secret key and webhook secret are stored encrypted in
# Postgres (see paymentSettingsService.js/stripeService.js). This key
# encrypts them at rest. Always required, even before Stripe is set up.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=replace-with-a-random-64-char-hex-string

CORS_ORIGIN=http://localhost:5173

# "Sign in with Google" — the OAuth 2.0 Client ID from Google Cloud
# Console (APIs & Services > Credentials). Only the Client ID is needed
# server-side; Google Identity Services' ID-token flow never exchanges the
# client secret with this backend. Unset means the endpoint responds 503.
GOOGLE_CLIENT_ID=

# Optional. Unset = sends are simulated (logged, not delivered) — see
# resendService.js. DataPit's own notification mail (verification, tickets,
# billing, promotions) — a separate provider/concern from ESP_API_KEY above.
# Resend API key (resend.com dashboard -> API Keys).
RESEND_API_KEY=
# Defaults to Resend's shared sandbox sender (onboarding@resend.dev), which
# only delivers to the Resend account's own address until a real domain is
# verified in Resend. Swap once datapit.io is verified there.
RESEND_FROM_EMAIL=
