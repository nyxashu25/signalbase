generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy: Org -> Workspace -> User, joined by Membership (which carries role).
// A user can belong to multiple workspaces across multiple orgs.
// ---------------------------------------------------------------------------

model Org {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  workspaces Workspace[]
}

// Mirrors the four tiers on the public Pricing page (pages/marketing/
// Pricing.jsx) — FREE is the default every workspace starts on, matching
// the "no plan = Free plan, limited" behavior. Credit grants and feature
// gates per plan live in config/planConfig.js, not here, so pricing changes
// never need a migration.
enum Plan {
  FREE
  BASIC
  PROFESSIONAL
  ORGANIZATION
}

// How often a paid subscription bills — see config/planConfig.js for the
// month-count and discount each maps to.
enum BillingInterval {
  MONTH
  QUARTER
  YEAR
}

model Workspace {
  id                   String          @id @default(uuid())
  orgId                String
  name                 String
  plan                 Plan            @default(FREE)
  monthlyCreditGrant   Int             @default(100)
  // Null until the workspace has ever started a checkout — billing is
  // opt-in, not every workspace has a Stripe customer.
  stripeCustomerId     String?         @unique
  stripeSubscriptionId String?         @unique
  // Set when a paid subscription checkout activates (see
  // stripeService.activatePlanSubscription) — never touched by the
  // super-admin plan override, which is a support action, not a purchase.
  // Drives the minimum commitment: self-serve downgrade between paid tiers
  // is blocked until billingInterval's length has elapsed since this date
  // (1/3/12 months for MONTH/QUARTER/YEAR — the interval IS the commitment).
  planActivatedAt      DateTime?
  billingInterval      BillingInterval @default(MONTH)
  // Paid seat count — how many people may hold a Membership or pending
  // invite here. 1 on FREE (per the pricing page); set by the subscription
  // checkout quantity or a super-admin override. Enforced when an invite is
  // created AND when it's accepted (workspaceService/authService), never
  // retroactively — reducing seats below the current member count only
  // blocks further joins.
  seats                Int             @default(1)
  // Purchased seat blocks (see planConfig.BLOCK_CONFIG). Each block bundles
  // paid + free seats; capacity = blocks x per-block counts. 0 on FREE.
  // Replaces `seats` as the capacity source once block billing lands —
  // `seats`/`monthlyCreditGrant` above are legacy, kept until a cleanup
  // migration drops them.
  blocks               Int             @default(0)
  // Super-admin workspace freeze — blocks every authenticated request for
  // members of this workspace (workspaceGuard middleware) without touching
  // individual User.suspendedAt flags. Reversible.
  suspendedAt          DateTime?
  // Soft delete (super-admin). Hidden everywhere while set; restorable from
  // the admin "Deleted" section; hard-purged by the deletion-purge job 60
  // days after this timestamp.
  deletedAt            DateTime?
  // Workspace branding (Settings → Workspace), available on every plan.
  // `logoUrl` holds a small image inline as a data: URI (capped in
  // workspaceService) rather than a file path — no storage infra, and it's
  // deliberately kept OUT of the lightweight session/auth-me payloads so
  // hot paths stay small. `motto` is an optional one-liner.
  logoUrl              String?
  motto                String?
  createdAt            DateTime        @default(now())

  org                Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships        Membership[]
  lists              List[]
  creditLedger       CreditLedgerEntry[]
  emailReveals       EmailReveal[]
  companyDetailViews CompanyDetailView[]
  sequences          Sequence[]
  enrollments        SequenceEnrollment[]
  suppressions       SuppressionEntry[]
  tickets            Ticket[]
  savedSearches      SavedSearch[]
  onboardingTasks    OnboardingTaskCompletion[]
  invites            WorkspaceInvite[]

  @@index([orgId])
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  // Optional because a Google-only account (see googleId) never sets one —
  // authService.login's verifyPassword call is null-safe (returns false
  // rather than throwing) so such an account simply can't log in with a
  // password until/unless it also sets one.
  passwordHash        String?
  name                String
  // Google "sub" claim once this account has signed in with Google — set
  // either at signup (Google-only account) or retroactively the first time
  // an existing password account signs in with Google using the same
  // verified email (see authService.loginWithGoogle). Null means never
  // linked.
  googleId            String?   @unique
  // Set by a super admin (see SuperAdmin below) to immediately cut off
  // login/refresh — checked in authService.login/refresh, not per-request,
  // matching this app's stateless-access-token design (see docs on
  // ACCESS_TOKEN_TTL_SECONDS). Null means never suspended.
  suspendedAt         DateTime?
  // Password signups start false and can't log in until they click the
  // confirm link emailed to them (see authService.verifyEmail); Google
  // signups start true since Google already verified the email. Grandfathered
  // to true for every account that existed before this field was added — see
  // the add_email_verification migration.
  emailVerified       Boolean   @default(false)
  // Opts a user out of the admin promotional broadcast (see
  // adminService.sendPromotionalBroadcast) without touching their ability to
  // receive transactional mail (verification, tickets, billing). Set via the
  // unsubscribe link every promotional email includes.
  marketingOptOut     Boolean   @default(false)
  // Null until the guided first-login tour is finished or skipped — checked
  // once per session by the frontend to decide whether to show it. Set once
  // and never cleared, so it truly shows only the first time, across
  // devices/browsers, not per-localStorage.
  tutorialCompletedAt DateTime?
  // Soft delete (super-admin). Blocks login/refresh like suspendedAt, hides
  // the user from member lists; restorable from the admin "Deleted" section;
  // hard-purged by the deletion-purge job 60 days after this timestamp.
  deletedAt           DateTime?
  // When this user last received their personal monthly credit grant — the
  // FREE-plan 800/mo sweep's cursor (monthlyGrantProcessor). A guarded
  // updateMany on this field is the concurrency lock that makes the grant
  // exactly-once. Null = never granted (new pre-sweep account).
  lastMonthlyGrantAt  DateTime?
  createdAt           DateTime  @default(now())

  memberships        Membership[]
  emailReveals       EmailReveal[]
  companyDetailViews CompanyDetailView[]
  createdLists       List[]              @relation("ListCreatedBy")
  createdSavedSearches SavedSearch[]     @relation("SavedSearchCreatedBy")
  createdSequences   Sequence[]          @relation("SequenceCreatedBy")
  createdTickets     Ticket[]
  ticketMessages     TicketMessage[]
  sentInvites        WorkspaceInvite[]   @relation("InvitedBy")
  apiKeys            ApiKey[]

  @@index([deletedAt])
  @@index([lastMonthlyGrantAt])
}

// A personal API credential (Settings → API & Extension) — how the Chrome
// extension (and, later, any public-API client) authenticates as a user
// without a browser session. The full key (`dpk_<hex>`) is shown exactly
// once at creation and stored only as an argon2 hash; `prefix` (the first
// characters of the key) is the plaintext lookup handle, so verification is
// one indexed read + one hash check, never a table scan. Revocation is a
// soft delete (revokedAt) so `lastUsedAt` history survives for the UI.
// Requests authenticate against the user's primary (first-joined) workspace
// — same resolution as login. See middleware/apiKeyAuth.js.
model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  name       String
  prefix     String    @unique
  keyHash    String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A pending seat invite (Settings → Users & teams). The emailed link carries
// a purpose-scoped JWT holding this row's id; the row is the source of truth
// for revocation (delete), expiry and single-use (acceptedAt) — the JWT
// alone is never enough. One live invite per (workspace, email); re-inviting
// refreshes the row. Accepting creates a Membership with `role` and, for a
// brand-new email, a User — never a new org/workspace.
model WorkspaceInvite {
  id          String    @id @default(uuid())
  workspaceId String
  email       String
  role        Role      @default(MEMBER)
  invitedById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Super admin: entirely separate credential space from the tenant User
// model above — no membership, no workspace, no shared login route. Signed
// with its own JWT secret (ADMIN_JWT_SECRET) and audience claim so a tenant
// access token can never be replayed against an admin-only route, or vice
// versa. See middleware/adminAuth.js and routes/admin.js.
// ---------------------------------------------------------------------------

model SuperAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  uploadedImportBatches DatabaseImportBatch[] @relation("UploadedBy")
  approvedImportBatches DatabaseImportBatch[] @relation("ApprovedBy")
  ticketMessages        TicketMessage[]
  auditLogEntries       AdminAuditLog[]
}

enum AdminAuditAction {
  SUSPEND_USER
  UNSUSPEND_USER
  UPDATE_PLAN
  ADD_CREDITS
  SAVE_STRIPE_SETTINGS
  APPROVE_IMPORT
  SEND_PROMOTION
  // Extension-sourcing queues (metadata carries the resolution + row id):
  // RESOLVE_MISSING_PERSON = Mark added / Dismiss on "Pending peoples";
  // RESOLVE_LOST_CHILD = Apply / Dismiss on "Childs found" — Apply mutates
  // the shared Contact row, which is exactly why it must be audited.
  RESOLVE_MISSING_PERSON
  RESOLVE_LOST_CHILD
  // Per-user credit adjustment with an explicit mode (add/remove/set) —
  // distinct from the legacy workspace-era ADD_CREDITS.
  ADJUST_USER_CREDITS
  // Workspace lifecycle (suspend = reversible freeze; delete = soft, purged
  // hard by the deletion-purge job after 60 days; restore undoes a delete).
  SUSPEND_WORKSPACE
  UNSUSPEND_WORKSPACE
  DELETE_WORKSPACE
  RESTORE_WORKSPACE
  DELETE_USER
  RESTORE_USER
  // Admin removed a member from a workspace (same action an OWNER can take).
  REMOVE_MEMBER
}

// Compliance trail for support-desk overrides — who (which super admin) did
// what to whom. targetUserId is deliberately a plain field, not a relation
// (same "soft reference" pattern as CreditLedgerEntry.contactId), so the log
// entry survives even if the target User row is later gone; look it up
// manually where needed rather than via `include`.
model AdminAuditLog {
  id           String           @id @default(uuid())
  superAdminId String
  action       AdminAuditAction
  targetUserId String?
  // Action-specific context — e.g. { amount } for ADD_CREDITS, { from, to }
  // for UPDATE_PLAN. Nothing here substitutes for the action enum itself.
  metadata     Json?
  createdAt    DateTime         @default(now())

  superAdmin SuperAdmin @relation(fields: [superAdminId], references: [id])

  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

enum ImportBatchStatus {
  PROCESSING
  PENDING_APPROVAL
  APPROVED
  FAILED
}

// A super-admin-uploaded CSV in the RPF format ("Extend Database"). Parsed
// rows are inserted into Company/Contact immediately so admins can review
// the batch, but withheld from Elasticsearch (not searchable) until the
// batch is explicitly approved — see databaseImportService.js.
model DatabaseImportBatch {
  id                String            @id @default(uuid())
  filename          String
  status            ImportBatchStatus @default(PROCESSING)
  totalRows         Int
  insertedContacts  Int               @default(0)
  insertedCompanies Int               @default(0)
  errorCount        Int               @default(0)
  errors            Json?
  uploadedById      String
  approvedById      String?
  createdAt         DateTime          @default(now())
  processedAt       DateTime?
  approvedAt        DateTime?

  uploadedBy SuperAdmin  @relation("UploadedBy", fields: [uploadedById], references: [id])
  approvedBy SuperAdmin? @relation("ApprovedBy", fields: [approvedById], references: [id])
  companies  Company[]
  contacts   Contact[]

  @@index([status])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

// Which seat a member occupies under block billing (planConfig.BLOCK_CONFIG):
// PAID seats earn the plan's per-seat monthly credits, FREE seats earn the
// flat free-seat rate, PENDING means the member has joined but isn't covered
// by a purchased block yet — they can log in but hold no spendable credits
// until the owner's payment covers them. Ignored on FREE-plan workspaces
// (solo; the user earns via the free-user monthly sweep instead).
enum SeatType {
  PAID
  FREE
  PENDING
}

model Membership {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  role        Role     @default(MEMBER)
  seatType    SeatType @default(PENDING)
  // One-time 1,500-credit welcome gift, paid the first time this membership
  // becomes payment-covered (seatService.activateCoverage / seat assignment).
  // Flipped with a guarded updateMany so concurrent webhook redeliveries can
  // never double-grant. Null = not yet gifted.
  welcomeGiftAt DateTime?
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // One membership per (user, workspace) — role changes update this row, they
  // don't create a new one.
  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Data graph: Company/Contact are the shared dataset (not tenant-scoped) —
// every workspace searches the same underlying company/people database.
// Tenant-scoped state (what a workspace has saved/revealed) lives below.
// ---------------------------------------------------------------------------

model Company {
  id            String   @id @default(uuid())
  name          String
  domain        String   @unique
  industry      String?
  headcountMin  Int?
  headcountMax  Int?
  location      String?
  techStack     String[]
  linkedinUrl   String?
  // Set when this row came from a super-admin CSV import still awaiting
  // approval — see DatabaseImportBatch. Null for every pre-existing/seeded
  // row and for approved-batch rows (cleared on approval).
  importBatchId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contacts    Contact[]
  listItems   ListItem[]
  detailViews CompanyDetailView[]
  importBatch DatabaseImportBatch? @relation(fields: [importBatchId], references: [id])

  @@index([industry])
  @@index([name])
  @@index([importBatchId])
}

model Contact {
  id            String    @id @default(uuid())
  companyId     String
  firstName     String
  lastName      String
  title         String?
  seniority     String?
  department    String?
  // Populated once the pattern-finder/verifier has run (services/email*.js,
  // Phase 03). Serializers must mask this field unless the requesting
  // workspace has a matching EmailReveal row — see docs/07-credits-state.
  email         String?
  emailVerified Boolean   @default(false)
  phone         String?
  linkedinUrl   String?
  // Normalized LinkedIn identity — the `<slug>` of linkedin.com/in/<slug>,
  // lowercased, query/fragment/trailing-slash stripped (utils/linkedin.js).
  // This is what the Chrome extension matches profile visits against; a raw
  // URL comparison would miss ?utm params, country subdomains, and casing.
  // Indexed, deliberately NOT unique: the importer inserts rather than
  // upserts (re-uploads are expected), so duplicates can exist — lookups
  // take the best row (see extensionService.js).
  linkedinSlug  String?
  // Set by a GDPR/CCPA erasure request (privacyService.js) — once set, PII
  // fields above are wiped and this contact is permanently excluded from
  // search/reveal, not just for the workspace that requested it.
  redactedAt    DateTime?
  // See Company.importBatchId — same staged-for-review semantics.
  importBatchId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  listItems    ListItem[]
  emailReveals EmailReveal[]
  enrollments  SequenceEnrollment[]
  importBatch  DatabaseImportBatch? @relation(fields: [importBatchId], references: [id])
  lostChildren LostChild[]

  @@index([companyId])
  @@index([lastName, firstName])
  @@index([importBatchId])
  @@index([linkedinSlug])
}

// ---------------------------------------------------------------------------
// Chrome-extension sourcing pipeline. When the extension observes a LinkedIn
// profile (POST /extension/observe), the visit lands in exactly one of two
// queues below — or nowhere, when the profile matches a Contact cleanly.
// Both are global (not workspace-scoped): they feed the shared data graph,
// and the super admin works them, not tenants. See extensionService.js and
// the /control "Pending peoples" / "Childs found" pages.
// ---------------------------------------------------------------------------

enum MissingPersonStatus {
  PENDING // awaiting sourcing — shown on "Pending peoples"
  ADDED // a contact with this slug now exists (manual mark, or auto on import)
  DISMISSED
}

// A LinkedIn profile the extension saw that we have no Contact for — the
// user's "missing peoples" database. One row per profile (linkedinSlug is
// unique): repeat sightings bump reportCount/lastReportedAt instead of
// duplicating, so the admin sees demand per profile, not noise. domText is
// the profile page's visible text (capped in the service) so an admin can
// hand-extract whatever the extension's parser missed.
model MissingPerson {
  id                String              @id @default(uuid())
  linkedinSlug      String              @unique
  linkedinUrl       String
  name              String?
  jobTitle          String?
  location          String?
  companyName       String?
  domText           String?
  status            MissingPersonStatus @default(PENDING)
  reportCount       Int                 @default(1)
  // Soft reference (same pattern as AdminAuditLog.targetUserId) — the queue
  // entry must survive the reporting user's deletion.
  firstReportedById String?
  lastReportedAt    DateTime            @default(now())
  createdAt         DateTime            @default(now())

  @@index([status, lastReportedAt])
}

enum LostChildStatus {
  PENDING // awaiting review — shown on "Childs found"
  APPLIED // admin accepted the observed title onto the Contact
  DISMISSED
}

// A contact whose LinkedIn job title no longer matches ours — the
// "lost-child" database. One PENDING row per contact (enforced in
// extensionService.js — Prisma has no conditional unique): re-observations
// update newTitle/reportCount in place, and resolving (APPLIED/DISMISSED)
// lets a future observation open a fresh row.
model LostChild {
  id                  String          @id @default(uuid())
  contactId           String
  linkedinSlug        String
  oldTitle            String?
  newTitle            String
  observedCompanyName String?
  domText             String?
  status              LostChildStatus @default(PENDING)
  reportCount         Int             @default(1)
  firstReportedById   String?
  lastReportedAt      DateTime        @default(now())
  createdAt           DateTime        @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([status, lastReportedAt])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Tenant-scoped: every model below carries a workspaceId and every query
// against them MUST filter by the authenticated request's workspace.
// See src/middleware/auth.js and the isolation tests in lists.test.js.
// ---------------------------------------------------------------------------

enum ListType {
  CONTACTS
  COMPANIES
}

model List {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  type        ListType
  createdById String?
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("ListCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     ListItem[]

  @@index([workspaceId])
}

enum SavedSearchType {
  PEOPLE
  COMPANIES
}

// A named, workspace-shared shortcut back to a People/Companies search.
// `filters` is the frontend's filter state stored verbatim and replayed
// client-side (see pages/People.jsx) — the backend validates its size and
// shape but never interprets the keys, so adding a filter to the search
// screens doesn't require a migration here.
model SavedSearch {
  id          String          @id @default(uuid())
  workspaceId String
  createdById String?
  type        SavedSearchType
  name        String
  filters     Json
  createdAt   DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("SavedSearchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, type])
}

model ListItem {
  id        String   @id @default(uuid())
  listId    String
  // Exactly one of contactId/companyId is set, matching the parent List's
  // type. Enforced in the service layer (services/listService.js) — Prisma
  // has no declarative XOR constraint.
  contactId String?
  companyId String?
  addedAt   DateTime @default(now())

  list    List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@unique([listId, companyId])
  @@index([listId])
}

enum CreditReason {
  MONTHLY_GRANT
  EMAIL_REVEAL
  // A reveal made from the Chrome extension (4 credits vs the in-app 2) —
  // its own reason so the ledger says where the spend came from.
  EXTENSION_REVEAL
  COMPANY_VIEW
  CSV_EXPORT
  SEQUENCE_ENROLLMENT
  TOPUP
  ADJUSTMENT
  // Getting-started checklist rewards (see onboardingService.js) — kept
  // distinct from ADJUSTMENT so the ledger reads "Onboarding reward", not
  // "Adjustment", and so the total a workspace has earned is one SUM away.
  ONBOARDING_REWARD
  // The workspace owner's flat monthly bonus on Pro/Org plans (2,000/3,000 —
  // planConfig.BLOCK_CONFIG.ownerBonus), granted alongside MONTHLY_GRANT on
  // each paid invoice.
  OWNER_BONUS
  // One-time 1,500-credit gift when a membership first becomes
  // payment-covered (Membership.welcomeGiftAt guards exactly-once).
  WELCOME_GIFT
  // Owner-to-member personal credit transfer — every transfer writes a
  // matched pair: TRANSFER_OUT (negative) on the sender, TRANSFER_IN
  // (positive) on the receiver, both with spentById = sender.
  TRANSFER_IN
  TRANSFER_OUT
  // One-time baseline written by the shared-pool -> per-user migration: the
  // workspace's whole legacy balance, credited to the owner's personal
  // balance. Also the marker the migration script keys its idempotency off.
  BALANCE_MIGRATION
}

// One row per (workspace, checklist key) once that task — or, for
// `group:*` keys, that whole group — is done. The checklist itself (which
// keys exist, labels, rewards) lives in config/onboardingConfig.js; this
// table only records completion and whether the reward has been paid out,
// so a task can never be rewarded twice even under concurrent requests
// (rewardedAt is flipped with a guarded updateMany). Append-only in
// practice: nothing un-completes a task.
model OnboardingTaskCompletion {
  id            String    @id @default(uuid())
  workspaceId   String
  key           String
  completedAt   DateTime  @default(now())
  rewardCredits Int       @default(0)
  rewardedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

// Append-only — never UPDATE or DELETE a row. Since the per-user migration,
// a USER's balance is SUM(delta WHERE userId = them) [- reservations held in
// Redis]; rows with userId = null are legacy shared-pool history whose value
// was absorbed into the owner's BALANCE_MIGRATION baseline row.
// See README.md "How the credit flow works".
model CreditLedgerEntry {
  id          String       @id @default(uuid())
  workspaceId String
  // Whose PERSONAL balance this row moved — a soft reference like spentById
  // below, so the row survives account deletion. Null only on legacy rows
  // written before the per-user migration (shared-pool era).
  userId      String?
  delta       Int
  reason      CreditReason
  contactId   String?
  // The teammate whose action spent (or earned) these credits — a soft
  // reference (plain id, like contactId above / AdminAuditLog.targetUserId),
  // so the ledger row survives the member leaving. Null on system/webhook
  // rows that no teammate triggered (MONTHLY_GRANT, TOPUP, ONBOARDING_REWARD,
  // super-admin ADJUSTMENT) and on pre-existing rows this column predates.
  // Powers the per-member team audit (workspaceService.teamAudit).
  spentById   String?
  // Real money charged for this entry, in cents — only ever set on TOPUP
  // rows (a real Stripe purchase). Null for everything else, including
  // ADJUSTMENT rows (an admin-granted credit isn't revenue). This is the
  // only place a dollar amount is recorded anywhere in the schema; the
  // credit ledger otherwise deals purely in credit counts.
  amountCents Int?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, spentById])
  @@index([userId, createdAt])
}

// Audit trail + reveal-state: once any member of a workspace reveals a
// contact's email, the whole workspace can see it (the unique constraint is
// what makes reveals workspace-wide rather than per-user).
model EmailReveal {
  id           String   @id @default(uuid())
  workspaceId  String
  contactId    String
  revealedById String?
  createdAt    DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  revealedBy User?     @relation(fields: [revealedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, contactId])
  @@index([workspaceId])
}

// Same shape and purpose as EmailReveal above, for the Company detail page:
// once any member of a workspace has paid to view a company's profile, the
// whole workspace can revisit it for free — the unique constraint is what
// makes a view workspace-wide and one-time rather than per-user/per-visit.
model CompanyDetailView {
  id          String   @id @default(uuid())
  workspaceId String
  companyId   String
  viewedById  String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  viewedBy  User?     @relation(fields: [viewedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, companyId])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Engagement: multi-step email cadences. A Sequence is a template (its
// Steps); a SequenceEnrollment is one contact's progress through it.
// ---------------------------------------------------------------------------

enum SequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Sequence {
  id          String         @id @default(uuid())
  workspaceId String
  name        String
  status      SequenceStatus @default(DRAFT)
  createdById String?
  createdAt   DateTime       @default(now())

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?                @relation("SequenceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([workspaceId])
}

enum StepType {
  EMAIL
  WAIT
}

model SequenceStep {
  id         String   @id @default(uuid())
  sequenceId String
  // 0-based position — the engine advances currentStepIndex through these.
  order      Int
  type       StepType
  // WAIT steps only:
  waitDays   Int?
  // EMAIL steps only:
  subject    String?
  body       String?

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, order])
  @@index([sequenceId])
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  UNENROLLED
}

model SequenceEnrollment {
  id               String           @id @default(uuid())
  sequenceId       String
  // Denormalized from Sequence so isolation queries never need a join —
  // same defense-in-depth pattern as List/CreditLedgerEntry.
  workspaceId      String
  contactId        String
  status           EnrollmentStatus @default(ACTIVE)
  currentStepIndex Int              @default(0)
  // When the scheduler should next advance this enrollment. Indexed — the
  // due-step processor's whole query is "WHERE nextStepDueAt <= now()".
  nextStepDueAt    DateTime?
  enrolledAt       DateTime         @default(now())
  unenrolledAt     DateTime?
  unenrolledReason String?

  sequence  Sequence            @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  events    SequenceStepEvent[]

  // A contact can only be enrolled in a given sequence once at a time.
  @@unique([sequenceId, contactId])
  @@index([workspaceId])
  @@index([nextStepDueAt])
}

enum StepEventType {
  SENT
  OPENED
  CLICKED
  BOUNCED
  REPLIED
  UNSUBSCRIBED
}

model SequenceStepEvent {
  id              String        @id @default(uuid())
  enrollmentId    String
  stepIndex       Int
  type            StepEventType
  // The ESP's own event id, when it has one (webhook deliveries). Unique so
  // an at-least-once webhook redelivery can't double-count a SENT/OPENED/etc.
  providerEventId String?       @unique
  createdAt       DateTime      @default(now())

  enrollment SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}

enum SuppressionReason {
  UNSUBSCRIBED
  BOUNCED
  MANUAL
}

// Workspace-scoped (not global) — a recipient unsubscribes from *this
// workspace's* sends, which is also what CAN-SPAM/GDPR compliance tracks
// per-sender. Checked at send time in the step processor, not at
// enrollment time — see sequenceProcessor.js.
model SuppressionEntry {
  id          String            @id @default(uuid())
  workspaceId String
  email       String
  reason      SuppressionReason
  createdAt   DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Privacy / data-subject rights. Global, not workspace-scoped — this is a
// real person's right over the shared data graph itself, orthogonal to
// which tenant looked them up. See privacyService.js.
// ---------------------------------------------------------------------------

model DataSubjectOptOut {
  id          String   @id @default(uuid())
  email       String   @unique
  reason      String?
  requestedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Platform-wide (not workspace-scoped) payment gateway config, set by a
// super admin — see paymentSettingsService.js. Single row, id fixed to
// 'stripe' in application code rather than a schema default so every
// read/write path is an explicit, greppable literal.
// Secrets are AES-256-GCM ciphertext (see utils/crypto.js), never plaintext.
// ---------------------------------------------------------------------------

model PaymentGatewaySettings {
  id                     String   @id
  keySecretEncrypted     String?
  webhookSecretEncrypted String?
  updatedAt              DateTime @updatedAt
  updatedById            String?
}

// ---------------------------------------------------------------------------
// Support/sales ticketing. A Ticket is one thread; its opening message and
// every reply (from either side) are TicketMessage rows in creation order —
// there's no separate "body" field on Ticket itself, so the UI renders the
// thread uniformly instead of special-casing the first message. Predefined
// subjects and the 200-word reply limit live in config/ticketConfig.js, not
// here, matching the plan/credit config pattern elsewhere in this schema.
// ---------------------------------------------------------------------------

enum TicketType {
  SUPPORT
  SALES
}

// UNANSWERED: waiting on the admin (just created, or the user replied most
// recently). ANSWERED: the admin has replied and it's the user's turn.
// CLOSED: resolved, no further replies accepted. "Active" (shown to the
// user as their open tickets) is UNANSWERED + ANSWERED.
enum TicketStatus {
  UNANSWERED
  ANSWERED
  CLOSED
}

enum TicketAuthorType {
  USER
  ADMIN
}

model Ticket {
  id          String       @id @default(uuid())
  workspaceId String
  createdById String?
  type        TicketType
  subject     String
  status      TicketStatus @default(UNANSWERED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  closedAt    DateTime?

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  messages  TicketMessage[]

  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

model TicketMessage {
  id            String           @id @default(uuid())
  ticketId      String
  authorType    TicketAuthorType
  // Exactly one of these is set, matching authorType — enforced in
  // ticketService.js, same convention as ListItem's contactId/companyId XOR.
  authorUserId  String?
  authorAdminId String?
  body          String
  createdAt     DateTime         @default(now())

  ticket      Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser  User?       @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorAdmin SuperAdmin? @relation(fields: [authorAdminId], references: [id])

  @@index([ticketId])
}
